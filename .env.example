# Reddit OAuth credentials (required for Reddit collection)
# Register your app at: https://www.reddit.com/prefs/apps
# Select "script" type. Set redirect URI to http://localhost:8080
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=ToxicMovieResearch/1.0 by YourRedditUsername

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=toxic_case_study
